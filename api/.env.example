# Local-only reference. In Docker Compose these are injected via docker-compose.yml / root .env.
PORT=4000
DATABASE_URL=postgres://planner:planner@localhost:5432/planner
REDIS_URL=redis://localhost:6379
# Comma-separated CORS / WebSocket origin allow-list
WEB_ORIGIN=http://localhost:5173
# Must be changed in production: the API refuses to start in production with this value.
JWT_SECRET=change_me_in_dev
# pino level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# Reverse-proxy hops to trust for client IPs (rate limiting); 0 = none
TRUST_PROXY=0
